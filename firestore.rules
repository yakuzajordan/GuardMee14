rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAgent() {
      return isAuth() && getRole() in ['agent', 'admin'];
    }
    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }

    // Users: owner can read/write their own profile; agents/admins can read all
    match /users/{uid} {
      allow read: if isOwner(uid) || isAgent();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Incidents: anyone authenticated can create; owner or agents can update
    match /incidents/{id} {
      allow read: if true; // public map
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.reporterId == request.auth.uid || isAgent()
      );
      allow delete: if isAdmin();
    }

    // Alerts: agents/admins manage alerts; anyone can read
    match /alerts/{id} {
      allow read: if true;
      allow write: if isAgent();
    }

    // Resources: agents/admins manage resources; anyone can read
    match /resources/{id} {
      allow read: if true;
      allow write: if isAgent();
    }

    // Notifications: only the owner can read/write their notifications
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isOwner(uid);
    }
  }
}
