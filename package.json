{
  "name": "guardmee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-firebase-sw.js && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently -n \"front,back\" -c \"cyan,magenta\" \"npm run dev\" \"npm run dev:backend\"",
    "install:all": "npm install && npm install --prefix backend"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "firebase": "^11.1.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.3.1",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.4": true
  }
}
